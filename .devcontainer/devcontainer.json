{
  "name": "yard",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "amzn"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Docker-in-Docker needs this — it's what makes it an isolated *nested*
  // daemon rather than a mount of the host's docker.sock. See the chat
  // history / commit message for the tradeoff this was chosen over.
  "privileged": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "vscjava.vscode-java-pack",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // Pull postgres + the Testcontainers sidecar (ryuk, which it spins up
  // automatically to clean up test containers) once, before the firewall
  // locks egress down, so a `./gradlew test` run never needs a live pull
  // once the allowlist is enforced. Runs once per container creation, not
  // per start. If Testcontainers' ryuk version bumps, this tag will drift
  // out of sync — check the pull error for the version it actually wants.
  "postCreateCommand": "docker pull postgres:17 && docker pull testcontainers/ryuk:0.11.0",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
