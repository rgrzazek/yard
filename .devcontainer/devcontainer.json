{
  "name": "yard",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // TZ is normally unset in a macOS shell, so the fallback is what actually
      // applies. Left at the template's US default this container logged in
      // Pacific time while the host ran on AEST.
      "TZ": "${localEnv:TZ:Australia/Sydney}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "amzn"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Docker-in-Docker needs this — it's what makes it an isolated *nested*
  // daemon rather than a mount of the host's docker.sock, which would hand the
  // container control of the host's real daemon (one `docker run -v /:/host`
  // reaches everything).
  //
  // Know what this buys and what it doesn't: the container is NOT the security
  // boundary. DinD requires `node` to be in the docker group, which is
  // root-equivalent, and `privileged` turns container-root into root on
  // whatever kernel is underneath. On macOS that kernel belongs to the Docker
  // Desktop VM, and the hypervisor is the real wall — which is why this is a
  // reasonable place to run an agent with permissions skipped. On a Linux host
  // that same kernel is the actual machine, and this config would be
  // materially less safe. Don't carry the mental model across.
  "privileged": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "vscjava.vscode-java-pack",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  // This is a live bind mount, not a copy — every write to /workspace lands on
  // the host filesystem immediately. The container protects the machine around
  // your code; git is what protects the code itself.
  //
  // Host prerequisite that lives outside this repo: Docker Desktop's file
  // sharing should be scoped to this project directory only (Settings >
  // Resources > File sharing), not the default /Users. That scoping is what
  // keeps even a VM-level escape boring, and cloning this repo does not bring
  // it with you. `consistency=delegated` is a Docker-Desktop-on-macOS
  // performance hint and a no-op elsewhere.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // A real `docker run -p`, which Docker Desktop maps to 0.0.0.0:8080 on the
  // Mac — so the dev server is reachable from a phone on the same wifi. This
  // is NOT the same mechanism as VS Code's "forwardPorts", which only ever
  // binds the host's loopback and so can't serve anything off-machine.
  "appPort": ["8080:8080"],
  // Stop VS Code from auto-forwarding every port it notices onto the Mac's
  // loopback. It does that silently, and a forwarded port is a held port: with
  // 8080 and 5432 taken by the forwarder, running ./dev.sh on the Mac fails
  // with "address already in use" and nothing says why. Ports we actually want
  // published are declared above, deliberately.
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  // Pull postgres + the Testcontainers sidecar (ryuk, which it spins up
  // automatically to clean up test containers) once, so a `./gradlew test` run
  // isn't waiting on a live pull. Runs once per container creation, not per
  // start. If Testcontainers' ryuk version bumps, this tag will drift out of
  // sync — check the pull error for the version it actually wants.
  "postCreateCommand": "docker pull postgres:17 && docker pull testcontainers/ryuk:0.11.0",
  "waitFor": "postCreateCommand"
}
